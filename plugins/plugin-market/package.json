{
  "name": "@dsh-desktop/plugin-market",
  "version": "0.1.0",
  "description": "插件市场：搜索全网 DSH 插件、一键安装（含按包名安装、拖入安装包）",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yansenlei/dsh-desktop.git"
  },
  "homepage": "https://github.com/yansenlei/dsh-desktop"
}
