# 发版时自动更新下载页版本信息（复制到 dsh-desktop 仓库的 .github/workflows/ 下）
#
# 原理：打 v* tag → 本 workflow 调用 site/tools/gen-latest-json.mjs
#       拉取 Releases/latest 生成 site/latest.json → 提交回仓库。
#       下载页加载时自动从 latest.json（同源 / jsDelivr / GitHub raw）获取最新版本并刷新按钮。
#       页面 HTML 从此无需在每次发版时修改。
name: publish-latest-json

on:
  push:
    tags: ['v*']

permissions:
  contents: write

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: 生成 site/latest.json
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: node site/tools/gen-latest-json.mjs

      - name: 提交并推送
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add site/latest.json
          if ! git diff --cached --quiet; then
            git commit -m "chore(site): update latest.json → ${{ github.ref_name }}"
            git push
          else
            echo "latest.json 无变化，跳过提交"
          fi
